[Unit]
Description=mai journal application (one worker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maimai
Group=maimai
WorkingDirectory=/srv/mai-journal/current
EnvironmentFile=/etc/mai-journal/app.env
EnvironmentFile=/srv/mai-journal/current/release.env
Environment=MAIMAI_ENV=production
Environment=MAIMAI_RUNTIME_DIR=/srv/mai-journal/shared/runtime
Environment=MAIMAI_CATALOG_DIR=/srv/mai-journal/shared/catalog
Environment=MAIMAI_ASSETS_DIR=/srv/mai-journal/shared/assets
Environment=MAIMAI_FRONTEND_DIR=/srv/mai-journal/current/frontend/dist
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/mai-journal/current/venv/bin/python -m uvicorn backend.app:create_app --factory --host 127.0.0.1 --port 8766 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=210
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/mai-journal/shared/runtime /srv/mai-journal/shared/catalog
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
