[Unit]
Description=Encrypted consistent mai journal backup
After=network-online.target
StartLimitIntervalSec=2h
StartLimitBurst=3

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /opt/mai-journal/backup.py backup
ExecStopPost=/usr/bin/python3 /opt/mai-journal/backup.py resume
TimeoutStartSec=90min
TimeoutStopSec=6min
Restart=on-failure
RestartSec=15min
UMask=0077
Nice=10
IOSchedulingClass=idle
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/mai-journal /srv/mai-journal/deploy.lock /srv/mai-journal/shared/catalog/updates/publish.lock
NoNewPrivileges=yes

