[Unit]
Description=Encrypted daily mai journal backup
StartLimitIntervalSec=2h
StartLimitBurst=3

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /opt/mai-journal/backup.py backup
TimeoutStartSec=60min
Restart=on-failure
RestartSec=15min
UMask=0077
Nice=10
IOSchedulingClass=idle
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/mai-journal /srv/mai-journal/shared/catalog/updates/publish.lock
NoNewPrivileges=yes
