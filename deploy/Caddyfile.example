# The app owns Master Key login; enable this only after its auth preflight passes.
maimai.example.com {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=15552000"
	}
	reverse_proxy 127.0.0.1:8766 {
		header_up -Authorization
		header_up -Forwarded
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
	# A connection failure must be a typed response, never an empty download.
	# Upstream application errors pass through unchanged.
	handle_errors {
		header {
			Cache-Control no-store
			Retry-After 5
			-Content-Disposition
		}
		@api path /api /api/*
		handle @api {
			header Content-Type "application/json; charset=utf-8"
			respond `{"detail":"服务暂时不可用，请稍后重试。"}` 503
		}
		handle {
			header Content-Type "text/html; charset=utf-8"
			respond `<!doctype html><html lang="zh-CN"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta http-equiv="refresh" content="5"><title>mai journal</title><body><h1>mai journal</h1><p>服务暂时不可用，正在重新连接…</p></body></html>` 503
		}
	}
}
