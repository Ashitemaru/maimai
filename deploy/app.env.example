# Root-owned /etc/mai-journal/app.env, mode 0600. Add the HTTPS hostname here.
MAIMAI_ALLOWED_HOSTS=127.0.0.1,localhost
# Required in production. Generate with python -m backend.auth hash (stdin only).
# Copy the scrypt hash into this root-owned file; never store the Master Key here.
MAIMAI_MASTER_KEY_HASH=
# Optional private Wahlap broker; provision its fixed runtime and socket before enabling.
MAIMAI_WAHLAP_ENABLED=0
MAIMAI_WAHLAP_SOCKET=/run/mai-journal-wahlap.sock
