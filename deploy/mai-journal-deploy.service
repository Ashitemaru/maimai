[Unit]
Description=Pull a CI-approved mai journal release
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=maimai
Group=maimai
EnvironmentFile=/etc/mai-journal/deploy.env
WorkingDirectory=/srv/mai-journal
ExecStart=/usr/bin/python3 /opt/mai-journal/deploy_release.py
TimeoutStartSec=35min
UMask=0077
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/mai-journal
# This unit needs sudo for the three exact systemctl commands in sudoers.
# Do not set NoNewPrivileges=yes here; the application unit does set it.

