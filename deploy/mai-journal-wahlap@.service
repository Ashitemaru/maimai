[Unit]
Description=mai journal isolated Wahlap connection

[Service]
Type=exec
User=maimai
Group=maimai
WorkingDirectory=/srv/mai-journal/current
ExecStart=/srv/mai-journal/current/venv/bin/python -m backend.wahlap_service
StandardInput=socket
StandardOutput=inherit
StandardError=journal
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=MAIMAI_WAHLAP_ENABLED=1
Environment=MAIMAI_WAHLAP_RUNTIME_DIR=/opt/mai-journal-wahlap
Environment=MAIMAI_WAHLAP_STATE_DIR=/srv/mai-journal/shared/runtime/wahlap-worker
Environment=MAIMAI_WAHLAP_WINE=/usr/bin/wine
UMask=0077
LimitCORE=0
RuntimeMaxSec=200
TimeoutStopSec=190
KillMode=control-group
MemoryMax=1G
MemorySwapMax=1G
TasksMax=128
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/mai-journal/shared/runtime/wahlap-worker
# A masked host /proc prevents unprivileged bubblewrap from mounting its own PID namespace /proc.
# The untrusted runtime still runs inside bubblewrap with all capabilities dropped.
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
