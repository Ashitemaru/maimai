{
  "name": "mai-journal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:styles && npm run typecheck && vite build",
    "check:styles": "node scripts/check-styles.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:app": "node scripts/verify-app.mjs",
    "verify:webkit": "node scripts/verify-app.mjs --webkit auth detail venues publishing mobile",
    "verify:completion-export": "node scripts/verify-completion-export.mjs",
    "test:ci": "npm run build && npm run verify:app && npm run verify:completion-export",
    "generate:icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
